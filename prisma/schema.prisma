// Prisma schema for the Extras App
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env
// to create these tables in your local PostgreSQL database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // casting coordinator
  EXTRA
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
  NO_SHOW // accepted, but didn't turn up on the day (marked by the coordinator)
}

enum DeletionRequestStatus {
  NONE
  PENDING
  APPROVED
  DENIED
}

enum DeletionRequestedBy {
  EXTRA
  ADMIN
}

model Production {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "Wednesday season 3"
  createdAt DateTime @default(now())

  coordinators     User[] // admins tied to this production
  extraMemberships ExtraProduction[] // extras' memberships of this production
  shootDays        ShootDay[]
  locations        Location[]

  @@map("productions")
}

// Whether an extra is allowed on a production.
// Extras request to join (PENDING); the production's coordinator approves or denies.
enum MembershipStatus {
  PENDING
  APPROVED
  DENIED
}

model ExtraProduction {
  id                String           @id @default(uuid())
  extraProfileId    String
  productionId      String
  status            MembershipStatus @default(PENDING)
  requestedAt       DateTime         @default(now())
  reviewedAt        DateTime? // when the coordinator approved/denied
  reviewedByAdminId String? // which coordinator (User.id is a UUID string)

  extraProfile ExtraProfile @relation(fields: [extraProfileId], references: [id], onDelete: Cascade)
  production   Production   @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@unique([extraProfileId, productionId]) // one membership per extra per production
  @@map("extra_productions")
}

// A saved meeting point for a production, e.g. "Ashford Studios - Phase 1"
model Location {
  id           String     @id @default(uuid())
  name         String
  address      String
  latitude     Float? // optional, for a future map/pin-drop upgrade
  longitude    Float?
  productionId String
  production   Production @relation(fields: [productionId], references: [id])
  createdAt    DateTime   @default(now())

  @@map("locations")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String
  phone        String?
  createdAt    DateTime @default(now())

  // Only populated when role == EXTRA
  extraProfile ExtraProfile?

  // Only populated when role == ADMIN
  shootDaysCreated ShootDay[]
  productionId     String?
  production       Production? @relation(fields: [productionId], references: [id])

  deletionRequestStatus     DeletionRequestStatus @default(NONE)
  deletionRequestedAt       DateTime?
  deletionRequestedBy       DeletionRequestedBy?
  deletionReason            String?
  deletionReviewedAt        DateTime?
  deletionReviewedByAdminId String?
  deletedAt                 DateTime?
  
  // Notification badges (Phase 3 Part 8): when this user last opened each screen.
  // Anything created after this time counts as "new" and shows in the red badge.
  invitesLastSeenAt            DateTime @default(now()) // extras: My Invites
  deletionRequestsLastSeenAt   DateTime @default(now()) // coordinators: Deletion Requests
  productionRequestsLastSeenAt DateTime @default(now()) // coordinators: Production Requests
  
  // Forgot password (Phase 3 Part 10): one active reset code at a time
  resetCodeHash      String?   // bcrypt hash of the 6-digit code (never stored as plain text)
  resetCodeExpiresAt DateTime? // codes last 15 minutes
  resetCodeAttempts  Int       @default(0) // wrong guesses; the code is cancelled after 5

  // Log out other devices: logins (tokens) issued before this time stop working
  passwordChangedAt  DateTime?

  @@map("users")
}

model ExtraProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth      DateTime? @db.Date // replaces age; age is worked out from this
  gender           Gender?
  heightCm         Int?
  skills           String[] // e.g. ["stunt work", "horse riding", "sign language"]
  languages        String[] // e.g. ["English", "Irish", "French"]
  phoneNumber      String?
  contactEmail     String?
  availability     String[] // e.g. ["Everyday"] or ["Mondays", "Wednesdays", "Fridays"]
  facePhotoUrl     String?
  fullBodyPhotoUrl String?
  fcmToken         String?
  hasSmartphone    Boolean   @default(true) // false = gets call-request invites by email (Part 9)
  ibanEncrypted    String? // encrypted with BANK_DETAILS_ENCRYPTION_KEY, never stored as plain text
  bicEncrypted     String?
  accountHolderName String? // name on the bank account, exactly as the bank has it (required whenever IBAN/BIC are set)

  invites     CallInvite[]
  memberships ExtraProduction[] // which productions this extra is on (pending/approved/denied)

  @@map("extra_profiles")
}

model ShootDay {
  id              String     @id @default(uuid())
  productionId    String
  production      Production @relation(fields: [productionId], references: [id])
  date            DateTime
  location        String
  locationAddress String? // full address of the meeting point
  latitude        Float? // optional, for a future map/pin-drop upgrade
  longitude       Float?
  estimatedWrapAt DateTime? // optional estimated wrap time
  createdById     String
  createdBy       User       @relation(fields: [createdById], references: [id])
  createdAt       DateTime   @default(now())

  callRequests CallRequest[]

  @@map("shoot_days")
}

model CallRequest {
  id         String   @id @default(uuid())
  shootDayId String
  shootDay   ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)

  description    String // e.g. "20 men, fight scene"
  quantityNeeded Int

  // Matching criteria — kept flexible as JSON so we can add filters
  // without a migration every time, e.g.:
  // { "minAge": 25, "maxAge": 45, "gender": "MALE", "skills": ["stunt work"] }
  criteria Json

  createdAt DateTime @default(now())

  invites CallInvite[]

  @@map("call_requests")
}

model CallInvite {
  id            String      @id @default(uuid())
  callRequestId String
  callRequest   CallRequest @relation(fields: [callRequestId], references: [id], onDelete: Cascade)

  extraProfileId String
  extraProfile   ExtraProfile @relation(fields: [extraProfileId], references: [id], onDelete: Cascade)

  status      InviteStatus @default(PENDING)
  sentAt      DateTime     @default(now())
  respondedAt DateTime?
  finishedAt  DateTime? // when this extra was released on the day (set by the coordinator; starts as the shoot day's estimated wrap)

  // One extra should only be invited once per call request
  @@unique([callRequestId, extraProfileId])
  @@map("call_invites")
}
