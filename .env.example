# Copy this file to .env and fill in your own values. Never commit .env itself.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/extras_app"

# Port the API will run on
PORT=4000

# Secret used to sign JWTs — use a long random string in real deployments
JWT_SECRET="replace-this-with-a-long-random-string"

# How long an auth token stays valid
JWT_EXPIRES_IN="7d"

# Google Cloud key with Geocoding API + Places API (New) enabled (server-side only)
GOOGLE_GEOCODING_API_KEY=

# 64 hex characters used to encrypt bank details. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BANK_DETAILS_ENCRYPTION_KEY=

FIREBASE_STORAGE_BUCKET=

# Email (Brevo SMTP) — get these from Brevo: Settings → SMTP & API → SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Extras App